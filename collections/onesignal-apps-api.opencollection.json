        {
          "info": {
            "name": "View apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onesignal.com/apps",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "View the details of all of your current OneSignal apps"
        },
        {
          "info": {
            "name": "Create an app",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.onesignal.com/apps",
