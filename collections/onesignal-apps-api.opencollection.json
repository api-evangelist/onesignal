              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new OneSignal app"
        },
        {
          "info": {
            "name": "View an app",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onesignal.com/apps/:app_id",
